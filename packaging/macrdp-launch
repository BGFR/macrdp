#!/bin/bash
# macrdp launch wrapper.
#
# The LaunchAgent runs THIS script (not the binary directly). It reads a
# plain key=value config file and translates it into CLI flags, then execs the
# signed macrdp binary that sits next to it in the .app bundle.
#
# Why a wrapper:
#   * Editing config.env never touches a code signature — the binary and this
#     wrapper stay sealed inside the .app, so the Screen Recording /
#     Accessibility TCC grants (keyed to the binary's path + signature) survive.
#   * A future GUI controller can read/write the same config.env and just
#     `launchctl kickstart -k` this job to apply changes — no plist surgery.
#
# TCC note: `exec` replaces this process image with the macrdp binary, so the
# process that calls ScreenCaptureKit / CGEventPost IS the signed binary. The
# wrapper itself makes no privileged calls.
set -euo pipefail

# This script lives in macrdp.app/Contents/Resources/; the binary is the
# bundle's main executable one directory over in Contents/MacOS/.
HERE="$(cd "$(dirname "$0")" && pwd)"
BIN="$HERE/../MacOS/macrdp"

CONFIG="${MACRDP_CONFIG:-$HOME/Library/Application Support/macrdp/config.env}"

# ---- Defaults (overridden by config.env) ---------------------------------
BIND="127.0.0.1:3390"
USERNAME="$(id -un)"
USE_KEYCHAIN=1        # read the password from the login Keychain (non-interactive)
ENABLE_H264=0
ENABLE_AAC=0
HIDPI=0
UNMINIMIZE=0          # Cmd+Tab also un-minimizes the target app's window
VIRTUAL_DISPLAY=0     # serve a headless virtual display instead of mirroring
# Physical screen handling while a client is connected (only with VIRTUAL_DISPLAY=1):
#   none    - leave it on; your apps stay on it and the virtual desktop is empty
#   detach  - disable it; macOS moves your apps onto the virtual display (recommended)
#   capture - keep it active but gamma-black it; apps stay on it (for hardware
#             where 'detach' doesn't visibly blank the panel)
PRIMARY_MODE=none
CAPTURE_PRIMARY=0     # deprecated: PRIMARY_MODE wins; kept so old configs still work
VD_WIDTH=1920         # virtual-display resolution (only used when VIRTUAL_DISPLAY=1)
VD_HEIGHT=1080
EXTRA_FLAGS=""        # space-separated escape hatch for any flag not modeled above
# --------------------------------------------------------------------------

if [ -f "$CONFIG" ]; then
    # shellcheck disable=SC1090
    . "$CONFIG"
fi

args=( --bind "$BIND" --username "$USERNAME" )
[ "${USE_KEYCHAIN}" = "1" ] && args+=( --keychain )
[ "${ENABLE_H264}" = "1" ] && args+=( --enable-h264 )
[ "${ENABLE_AAC}" = "1" ]  && args+=( --enable-aac )
[ "${HIDPI}" = "1" ]       && args+=( --hidpi )
[ "${UNMINIMIZE}" = "1" ]  && args+=( --unminimize-on-switch )
if [ "${VIRTUAL_DISPLAY}" = "1" ]; then
    # --virtual-display requires --width/--height; --detach-primary /
    # --capture-primary require --virtual-display and are mutually exclusive.
    args+=( --virtual-display --width "${VD_WIDTH}" --height "${VD_HEIGHT}" )
    # Back-compat: an old config with CAPTURE_PRIMARY=1 and no PRIMARY_MODE.
    if [ "${PRIMARY_MODE}" = "none" ] && [ "${CAPTURE_PRIMARY}" = "1" ]; then
        PRIMARY_MODE=capture
    fi
    case "${PRIMARY_MODE}" in
        detach)  args+=( --detach-primary ) ;;
        capture) args+=( --capture-primary ) ;;
    esac
fi
# shellcheck disable=SC2206
[ -n "${EXTRA_FLAGS}" ] && args+=( ${EXTRA_FLAGS} )

exec "$BIN" "${args[@]}"
